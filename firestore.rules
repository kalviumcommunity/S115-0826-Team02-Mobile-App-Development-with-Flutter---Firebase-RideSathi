rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Reusable Functions
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRider() {
      return isAuthenticated() && getUserData().role == 'rider';
    }

    function isDriver() {
      return isAuthenticated() && getUserData().role == 'driver';
    }

    function isDispatcher() {
      return isAuthenticated() && getUserData().role == 'dispatcher';
    }

    // Admin role — the ONLY authoritative check for admin privileges.
    // Admin role is NEVER writable by the client.
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isAdminOrDispatcher() {
      return isAdmin() || isDispatcher();
    }

    // Ensures the client uses serverTimestamp for the given field
    function isServerTimestamp(field) {
      return request.resource.data[field] == request.time;
    }

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isModifyingProtectedFields() {
      return affectedKeys().hasAny(['id', 'email', 'role', 'createdAt']);
    }

    // -------------------------------------------------------------------------
    // Users Collection
    // -------------------------------------------------------------------------

    match /users/{userId} {
      // Authenticated users can read profiles (for matching, dispatch, admin)
      allow read: if isAuthenticated();

      // Creation: uid must match docId, role must be rider or driver, no escalation
      allow create: if isOwner(userId)
                    && request.resource.data.id == userId
                    && request.resource.data.role in ['rider', 'driver']
                    && request.resource.data.isUnionVerified == false
                    && isServerTimestamp('createdAt')
                    && isServerTimestamp('updatedAt');

      // Update: owner can change their own non-protected fields.
      // Admin can additionally update: isSuspended, suspendedReason, isUnionVerified, verificationStatus.
      // Neither owner nor admin can change: id, email, role, createdAt.
      allow update: if !isModifyingProtectedFields()
                    && isServerTimestamp('updatedAt')
                    && (
                      // Owner updates their own profile (cannot touch admin fields)
                      (isOwner(userId) && !affectedKeys().hasAny(['isSuspended', 'suspendedReason', 'isUnionVerified', 'verificationStatus'])) ||
                      // Admin can update suspension and verification state
                      isAdmin()
                    );
    }

    // -------------------------------------------------------------------------
    // Rides Collection
    // -------------------------------------------------------------------------

    match /rides/{rideId} {
      // Read: rider who created, assigned driver, dispatchers, admins
      // Any driver can read requested rides (for offer matching)
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        (isDriver() && resource.data.status == 'requested') ||
        isAdminOrDispatcher()
      );

      // Create: only riders, for themselves
      allow create: if isRider()
                    && request.resource.data.riderId == request.auth.uid
                    && request.resource.data.status == 'requested'
                    && isServerTimestamp('createdAt')
                    && isServerTimestamp('updatedAt');

      // Update: role-based permission matrix
      allow update: if isAuthenticated() && isServerTimestamp('updatedAt') && (
        // Admin can update anything on a ride (cancel, assign, reassign)
        isAdmin() ||

        // Dispatcher can assign/reassign
        isDispatcher() ||

        // Rider can cancel or provide feedback
        (resource.data.riderId == request.auth.uid && (
          (affectedKeys().hasOnly(['status', 'updatedAt']) && request.resource.data.status == 'cancelled') ||
          (affectedKeys().hasOnly(['feedback', 'updatedAt']) && request.resource.data.status == 'completed' && resource.data.status == 'completed')
        )) ||

        // Driver can accept, arrive, update location, start, complete
        (
          isDriver() &&
          (resource.data.driverId == null || resource.data.driverId == request.auth.uid) &&
          !affectedKeys().hasAny(['riderId', 'createdAt', 'estimatedFare', 'feedback'])
        )
      );
    }

    // -------------------------------------------------------------------------
    // Admin Audit Logs — immutable once written
    // -------------------------------------------------------------------------

    match /adminAuditLogs/{logId} {
      // Only admins can read audit logs
      allow read: if isAdmin();
      // Only admins can create audit entries
      allow create: if isAdmin() && isServerTimestamp('timestamp');
      // Nobody can update or delete audit logs (immutable)
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // System Settings — admin-only read/write
    // -------------------------------------------------------------------------

    match /systemSettings/{docId} {
      allow read: if isAdminOrDispatcher();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Deny all other collections by default
    // -------------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
