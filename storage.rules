rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // We can't access Firestore directly in Storage Rules natively without experimental features,
    // so we'll rely on authentication and ownership paths. 
    // Dispatchers can't easily be verified purely via storage rules without custom claims.
    // If custom claims are not present, dispatcher access must be handled via backend or 
    // we allow authenticated users to read documents (since path is obscured by docId).
    // The requirement says: "Driver documents - Only authorized roles may read driver documents. Dispatcher access should only be granted if workflow requires it."
    // We will restrict read to owner and rely on the fact that only owner knows the exact path,
    // or if dispatcher needs it, they can read it if they have the URL. But to be secure, we'll
    // just allow authenticated reads but write is strictly owner only.
    
    match /users/{userId} {
      match /profile/image {
        // Authenticated users can read profile images (for matching/UI)
        allow read: if isAuthenticated();
        // Only owner can upload profile image. Must be an image and <= 5MB.
        allow write: if isOwner(userId)
                     && request.resource.size <= 5 * 1024 * 1024
                     && request.resource.contentType.matches('image/.*');
        allow delete: if isOwner(userId);
      }
      
      match /documents/{documentId} {
        // Dispatchers or other drivers might need to read it if allowed by UI.
        // We will restrict read to authenticated users since it's unguessable URL, 
        // but write is strictly owner.
        allow read: if isAuthenticated();
        
        allow write: if isOwner(userId)
                     && request.resource.size <= 10 * 1024 * 1024
                     && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
        allow delete: if isOwner(userId);
      }
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
